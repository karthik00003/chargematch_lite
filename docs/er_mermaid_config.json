{
  "theme": "neutral",
  "layout": "elk",
  "themeVariables": {
    "fontSize": "20px",
    "fontFamily": "Helvetica, Arial, sans-serif"
  },
  "themeCSS": ".relationshipLabel, .edgeLabel, .edgeLabel text, .edgeLabel tspan { font-size: 22px !important; font-weight: 600; }",
