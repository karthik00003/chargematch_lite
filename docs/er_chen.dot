graph chen {
  graph [layout=neato, start=2, overlap=prism, overlap_scaling=-6, sep="+18", splines=true, outputorder=edgesfirst,
         pad=0.4, fontname="Helvetica", fontsize=26, labelloc=t,
         label=<<B>ChargeMatch: ER diagram (Chen notation)</B><BR/><FONT POINT-SIZE="16">generated from information_schema of chargematch_lite · double line = total participation · double box / diamond = weak entity / identifying relationship</FONT>>];
  node [fontname="Helvetica"];
  edge [color="#333333", penwidth=1.4, labelfontsize=22, labelfontname="Helvetica-Bold", labelfontcolor="#B00020",
        labeldistance=2.8, labelangle=28, len=1.6];
  "amenity" [shape=box, style="filled", fillcolor="#E8F4F6", color="#0B4048", penwidth=2, fontsize=22, fontname="Helvetica-Bold", label="amenity"];
  "amenity.amenity_id" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<<U>amenity_id</U>>];
  "amenity" -- "amenity.amenity_id" [len=1.0, penwidth=1, color="#777777"];
  "amenity.name" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<name>];
  "amenity" -- "amenity.name" [len=1.0, penwidth=1, color="#777777"];
  "amenity.icon" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<icon>];
  "amenity" -- "amenity.icon" [len=1.0, penwidth=1, color="#777777"];
  "bill" [shape=box, style="filled", fillcolor="#E8F4F6", color="#0B4048", penwidth=2, fontsize=22, fontname="Helvetica-Bold", label="bill"];
  "bill.bill_id" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<<U>bill_id</U>>];
