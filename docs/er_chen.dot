  "bill.kwh" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<kwh>];
  "bill" -- "bill.kwh" [len=1.0, penwidth=1, color="#777777"];
  "bill.rate" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<rate>];
  "bill" -- "bill.rate" [len=1.0, penwidth=1, color="#777777"];
