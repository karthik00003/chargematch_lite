  "bill" -- "bill.generated_at" [len=1.0, penwidth=1, color="#777777"];
  "bill.paid_at" [shape=ellipse, color="#5A5A5A", fontsize=15, fontname="Helvetica", margin="0.06,0.02", label=<paid_at>];
  "bill" -- "bill.paid_at" [len=1.0, penwidth=1, color="#777777"];
