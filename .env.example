# Template for .env — ./setup_db.sh creates/completes .env from this file and
# fills MYSQL_PASSWORD and SECRET_KEY with random values. .env is git-ignored.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Unix socket of the local MySQL server (Homebrew default). Used instead of
# host/port when set; leave empty to connect over TCP.
MYSQL_SOCKET=/tmp/mysql.sock
MYSQL_DB=chargematch_lite
MYSQL_USER=cmlite_app
MYSQL_PASSWORD=change_me

PORT=5060
SECRET_KEY=change_me
